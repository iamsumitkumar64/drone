# JWT Configuration
JWT_ACCESS_SECRET=cdcwrg3mNJyUKpvAvd3L9psS8wXMzcm4nNbA4ka1vneueuNSsFirdqft3goL7
JWT_ACCESS_EXPIRE_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Server & CORS Configuration
PORT=8090
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_POSTGRES_TYPE=postgres
DB_POSTGRES_HOST=database
DB_POSTGRES_PORT=5432
DB_POSTGRES_USERNAME=postgres
DB_POSTGRES_PASSWORD=123
DB_POSTGRES_DATABASE=db
DB_POSTGRES_LOGGING=false
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY=5000

# Docker Container User & Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=db

# PgAdmin Management Tool
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Lightweight LLM Configuration (Google Gemini / OpenAI)
# If left blank, the built-in heuristic classifier and chat engine is used automatically
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Telegram Bot Alerting & Chat Interface
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring Cron Schedule (default: every midnight "0 0 * * *")
MONITORING_CRON="0 0 * * *"